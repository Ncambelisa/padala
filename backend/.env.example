# Copy to .env for local development. Production uses a separate secret manager;
# use .env.production.example as a reference and never commit real values.
PADALA_ENV=development
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
# Required only in production. Example: app.example.com
ALLOWED_HOSTS=
# Required in production when Next.js proxies browser API calls to this private API.
# Example: INTERNAL_PROXY_ORIGINS=http://padala-api:8000
#          TRUSTED_PROXY_NETWORKS=10.42.0.0/16
INTERNAL_PROXY_ORIGINS=
TRUSTED_PROXY_NETWORKS=
SECURE_COOKIES=false
REGISTRATION_ENABLED=true
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_WORKER_ENABLED=true
# Production requires a managed TLS Redis endpoint and fail-closed enforcement.
REDIS_URL=
RATE_LIMIT_FAIL_CLOSED=false
# A private ClamAV-compatible clamd endpoint. Local development keeps scanning optional.
MALWARE_SCAN_HOST=
MALWARE_SCAN_PORT=3310
MALWARE_SCAN_REQUIRED=false
# Optional absolute location. By default: backend/data/
# DATA_DIR=/absolute/path/to/private/padala-data
# Optional database URL. SQLite is the supported/tested local default.
# DATABASE_URL=sqlite:////absolute/path/to/padala.sqlite3

# Optional Azure Document Intelligence. Your account, region and document support apply.
AZURE_DOCUMENT_ENDPOINT=
AZURE_DOCUMENT_KEY=

# Optional SMTP. Local Docker Compose supplies Mailpit instead of sending real email.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
EMAIL_FROM=Padala <no-reply@padala.local>

# Xendit subscriptions stay off until the operator has published customer-facing
# terms and completed a support/refund process. Never put these secrets in
# frontend variables or source control. Use Xendit test credentials first.
BILLING_ENABLED=false
BILLING_ENFORCEMENT_ENABLED=false
# Store prices as integer centavos. The approved catalogue is Padala Basic at
# PHP 99/month (up to 4 active household members) and Padala Family at PHP
# 149/month (up to 8). The first completed household enrollment gets one free
# month; a later re-enrollment has no repeat trial.
BILLING_BASIC_PRICE_MINOR=9900
BILLING_FAMILY_PRICE_MINOR=14900
BILLING_TRIAL_MONTHS=1
BILLING_TERMS_VERSION=
BILLING_TERMS_EFFECTIVE_DATE=
BILLING_SUPPORT_EMAIL=
BILLING_REFUND_SUMMARY=
BILLING_CANCELLATION_SUMMARY=
BILLING_TAX_SUMMARY=
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
# Leave at the official API base. Do not redirect this to an untrusted host.
XENDIT_API_BASE=https://api.xendit.co
