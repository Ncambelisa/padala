# Production reference only — put actual values in your hosting secret manager.
# Do not run until the release checklist and external approvals are complete.
PADALA_ENV=production
APP_URL=https://app.example.com
ALLOWED_ORIGINS=https://app.example.com
ALLOWED_HOSTS=app.example.com
# The exact private origin Next.js uses for API_INTERNAL_URL and only the network
# ranges from which that proxy reaches FastAPI. Do not use 0.0.0.0/0.
INTERNAL_PROXY_ORIGINS=http://padala-api.internal:8000
TRUSTED_PROXY_NETWORKS=10.42.0.0/16
SECURE_COOKIES=true
EMAIL_VERIFICATION_REQUIRED=true

# PostgreSQL only; this application refuses SQLite in production mode.
DATABASE_URL=postgresql+psycopg://PADALA_USER:REPLACE_ME@DB_HOST:5432/padala

# Shared, TLS-protected rate limiter. Keep its credential out of source control.
REDIS_URL=rediss://:REPLACE_ME@REDIS_HOST:6380/0
RATE_LIMIT_FAIL_CLOSED=true

# Private ClamAV-compatible clamd endpoint only. Do not expose this TCP port publicly.
# Configure clamd's StreamMaxLength at least as high as the application's 5 MB upload limit.
MALWARE_SCAN_HOST=clamd.internal.example.com
MALWARE_SCAN_PORT=3310
MALWARE_SCAN_REQUIRED=true

# API processes must not run the outbox worker. Run one dedicated worker instead:
# python -m app.worker
EMAIL_WORKER_ENABLED=false

# Use a verified sending domain and SMTP submission service that supports STARTTLS.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
SMTP_STARTTLS=true
EMAIL_FROM=Padala <support@example.com>

# Public privacy-notice fields. These are not secrets. Fill them after a
# Philippines privacy/legal review; production refuses to start if any is blank.
PRIVACY_CONTROLLER_NAME=Nico Cambelisa
PRIVACY_CONTROLLER_ADDRESS=Full business address in the Philippines
PRIVACY_CONTACT_EMAIL=privacy@example.com
PRIVACY_NOTICE_VERSION=1.0
PRIVACY_NOTICE_EFFECTIVE_DATE=2026-11-03
PRIVACY_LEGAL_BASIS_SUMMARY=Example only: processing is necessary to provide the requested household record service and, where required, with your consent. Replace after legal review.
PRIVACY_RETENTION_SUMMARY=Example only: active household records are retained while the pilot account is active, then deleted within 30 days after the approved closure process, subject to documented legal or dispute needs. Replace with the approved schedule.
PRIVACY_PROCESSORS_SUMMARY=Example only: list every production hosting, database, backup, email, malware-scanning, and optional document-extraction provider, their processing location, purpose, and applicable transfer safeguards. Replace before launch.

# Keep Azure disabled until its privacy, budget, and live synthetic-file validation gates are complete.
AZURE_DOCUMENT_ENDPOINT=
AZURE_DOCUMENT_KEY=

# Xendit public paid subscription. Keep both flags false until the Xendit test
# mode integration, webhook signature validation, public terms, refund/support
# handling, and a launch decision have been approved. Production refuses a public
# billing configuration that is incomplete or does not enforce paid access.
BILLING_ENABLED=false
BILLING_ENFORCEMENT_ENABLED=false
# Integer centavos. The selected customer offers are PHP 99/month for Padala
# Basic (up to 4 active household members) and PHP 149/month for Padala Family
# (up to 8). A completed household's first enrollment gets one free month.
BILLING_BASIC_PRICE_MINOR=9900
BILLING_FAMILY_PRICE_MINOR=14900
BILLING_TRIAL_MONTHS=1
BILLING_TERMS_VERSION=
BILLING_TERMS_EFFECTIVE_DATE=
BILLING_SUPPORT_EMAIL=
BILLING_REFUND_SUMMARY=
BILLING_CANCELLATION_SUMMARY=
BILLING_TAX_SUMMARY=
# Store both values only in the production secret manager. The callback token
# belongs in Xendit Dashboard > Webhook settings; never use a frontend variable.
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_API_BASE=https://api.xendit.co
